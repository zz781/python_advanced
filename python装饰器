from functools import wraps
import time

#无参数装饰器 #functools.wraps
def timers(func):
    @wraps(func)
    def wrapper(*args,**kwrags):
        print("执行timers")
        start=time.perf_counter()
        try:
            result=func(*args,**kwrags)
            return result
        finally:
            cost=time.perf_counter()-start
            print(f"消耗了{cost:.6f}秒")
    return wrapper

#带参数装饰器 #functools.wraps
def repeat(times:int):
    def decorator(func):
        @wraps(func)
        def wrapper(*args,**kwargs):
            print("执行repeat")
            
            for i in range(1,times+1):
                print(f"第{i}次")
                result=func(*args,**kwargs)
            return result
        return wrapper
    return decorator

#多层装饰器执行顺序
#装饰器语法糖
@timers
@repeat(2)
def say(name:str):
    print(f"hello!{name}")

#闭包
def outer(x):
    def inner(y):
        return x+y
    return inner



if __name__=="__main__":
    result=say("xiaoming")
    print("say.__name__=",say.__name__)
    print("say.__doc__=",say.__doc__)
    add=outer(5)
    print(add(3))
        
                

