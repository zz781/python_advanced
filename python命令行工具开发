import argparse

parser=argparse.ArgumentParser(description="这是一个命令行工具")
parser.add_argument("--length",type=int,default=10,help="这是长度")
parser.add_argument("--width",type=int,default=20,help="这是宽度")
arg=parser.parse_args()

if __name__=='__main__':
    result=arg.length*arg.width
    print(f'长方形的面积为：{result}')   